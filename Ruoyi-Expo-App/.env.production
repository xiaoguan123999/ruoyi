# 生产环境（pnpm build:web、pnpm build:android）
# 请改成正式服地址；H5 建议走 Nginx 同源反代 /prod-api，不要加 /dev-api

EXPO_PUBLIC_API_URL=https://h5.example.com/prod-api
# H5 前端站点（二维码打开注册页）；API 走上面的 /prod-api
EXPO_PUBLIC_H5_URL=https://h5.example.com
# 热更新：EXPO_OWNER / EXPO_PUBLIC_EAS_PROJECT_ID
# APK 下载地址不要写在这里，走后台「版本管理」downloadUrl
EXPO_OWNER=xfzl
EXPO_PUBLIC_EAS_PROJECT_ID=53c81e46-f43d-4e64-becf-2e7aae3406fd
