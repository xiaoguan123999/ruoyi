# 环境变量说明（可提交到仓库，作为模板）
#
# APP_ENV 取值：development（开发）| preview（测试）| production（生产）
# 加载顺序（后者覆盖前者）：
#   .env → .env.$APP_ENV → .env.local → .env.$APP_ENV.local
#
# 本机覆盖（局域网 IP 等）写到已忽略文件，例如：
#   .env.development.local
#
# EXPO_PUBLIC_API_URL：若依后端 origin，不要加 /dev-api（那是 Vue 管理端代理前缀）
#   开发 H5：http://localhost:8080
#   开发 App：http://192.168.x.x:8080（电脑局域网 IP）
#   生产 H5：建议 Nginx 同源反代，如 https://h5.example.com/prod-api
#
# EXPO_PUBLIC_H5_URL：H5 前端站点 origin（邀请二维码指向注册页，不要填后端 API）
#   开发：http://192.168.x.x:8081（Expo Web）
#   生产：https://h5.example.com
#   扫码结果示例：https://h5.example.com/sign-up?inviteCode=10004
#
# 发布流程（本地出包 → 上传 R2 → 热更新）：
#   测试：pnpm build:android:preview
#         pnpm upload:r2:preview
#         pnpm update:preview          # 仅 JS 变更、不换原生时
#   正式：pnpm build:android
#         pnpm upload:r2:production
#         pnpm update:production
# APK 会生成在项目根目录 xfzl-{version}.apk，不要提交 git。
# 安装包地址由后台「版本管理」downloadUrl 维护，不要写环境变量。

EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_H5_URL=http://localhost:8081
EXPO_OWNER=xfzl
EXPO_PUBLIC_EAS_PROJECT_ID=53c81e46-f43d-4e64-becf-2e7aae3406fd
