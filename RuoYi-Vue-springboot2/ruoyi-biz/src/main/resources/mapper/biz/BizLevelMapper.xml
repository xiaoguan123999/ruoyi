<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizLevelMapper">

    <resultMap type="BizLevel" id="BizLevelResult">
        <id     property="levelId"           column="level_id"/>
        <result property="levelName"         column="level_name"/>
        <result property="minValidMembers"   column="min_valid_members"/>
        <result property="minRechargeCny"    column="min_recharge_cny"/>
        <result property="minRechargeUsdt"   column="min_recharge_usdt"/>
        <result property="sort"              column="sort"/>
        <result property="status"            column="status"/>
        <result property="createBy"          column="create_by"/>
        <result property="createTime"        column="create_time"/>
        <result property="updateBy"          column="update_by"/>
        <result property="updateTime"        column="update_time"/>
        <result property="remark"            column="remark"/>
    </resultMap>

    <sql id="selectLevelVo">
        select level_id, level_name, min_valid_members, min_recharge_cny, min_recharge_usdt,
               sort, status, create_by, create_time, update_by, update_time, remark
        from biz_level
    </sql>

    <select id="selectLevelById" parameterType="Long" resultMap="BizLevelResult">
        <include refid="selectLevelVo"/>
        where level_id = #{levelId}
    </select>

    <select id="selectLevelList" parameterType="BizLevel" resultMap="BizLevelResult">
        <include refid="selectLevelVo"/>
        <where>
            <if test="levelName != null and levelName != ''">and level_name like concat('%', #{levelName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort asc, level_id asc
    </select>

    <insert id="insertLevel" parameterType="BizLevel" useGeneratedKeys="true" keyProperty="levelId">
        insert into biz_level (
            level_name, min_valid_members, min_recharge_cny, min_recharge_usdt,
            sort, status, create_by, create_time, remark
        ) values (
            #{levelName}, #{minValidMembers}, #{minRechargeCny}, #{minRechargeUsdt},
            #{sort}, #{status}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateLevel" parameterType="BizLevel">
        update biz_level
        <set>
            <if test="levelName != null and levelName != ''">level_name = #{levelName},</if>
            <if test="minValidMembers != null">min_valid_members = #{minValidMembers},</if>
            <if test="minRechargeCny != null">min_recharge_cny = #{minRechargeCny},</if>
            <if test="minRechargeUsdt != null">min_recharge_usdt = #{minRechargeUsdt},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where level_id = #{levelId}
    </update>

    <delete id="deleteLevelByIds" parameterType="Long">
        delete from biz_level where level_id in
        <foreach collection="array" item="levelId" open="(" separator="," close=")">
            #{levelId}
        </foreach>
    </delete>
</mapper>
