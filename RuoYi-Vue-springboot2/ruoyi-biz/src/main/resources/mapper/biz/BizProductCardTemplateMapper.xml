<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizProductCardTemplateMapper">

    <resultMap type="BizProductCardTemplate" id="BizProductCardTemplateResult">
        <id     property="templateId"       column="template_id"/>
        <result property="templateCode"     column="template_code"/>
        <result property="templateName"     column="template_name"/>
        <result property="previewUrl"       column="preview_url"/>
        <result property="metricSlotCount"  column="metric_slot_count"/>
        <result property="hasMainAmount"    column="has_main_amount"/>
        <result property="defaultCtaText"   column="default_cta_text"/>
        <result property="sort"             column="sort"/>
        <result property="status"           column="status"/>
        <result property="createBy"         column="create_by"/>
        <result property="createTime"       column="create_time"/>
        <result property="updateBy"         column="update_by"/>
        <result property="updateTime"       column="update_time"/>
        <result property="remark"           column="remark"/>
    </resultMap>

    <sql id="selectTemplateVo">
        select template_id, template_code, template_name, preview_url, metric_slot_count,
               has_main_amount, default_cta_text, sort, status,
               create_by, create_time, update_by, update_time, remark
        from biz_product_card_template
    </sql>

    <select id="selectTemplateById" parameterType="Long" resultMap="BizProductCardTemplateResult">
        <include refid="selectTemplateVo"/>
        where template_id = #{templateId}
    </select>

    <select id="selectTemplateByCode" parameterType="String" resultMap="BizProductCardTemplateResult">
        <include refid="selectTemplateVo"/>
        where template_code = #{templateCode}
        limit 1
    </select>

    <select id="selectTemplateList" parameterType="BizProductCardTemplate" resultMap="BizProductCardTemplateResult">
        <include refid="selectTemplateVo"/>
        <where>
            <if test="templateCode != null and templateCode != ''">and template_code = #{templateCode}</if>
            <if test="templateName != null and templateName != ''">and template_name like concat('%', #{templateName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort asc, template_id asc
    </select>

    <select id="selectEnabledOptions" resultMap="BizProductCardTemplateResult">
        <include refid="selectTemplateVo"/>
        where status = '0'
        order by sort asc, template_id asc
    </select>

    <select id="countProductByTemplateId" parameterType="Long" resultType="int">
        select count(1) from biz_product where template_id = #{templateId}
    </select>

    <insert id="insertTemplate" parameterType="BizProductCardTemplate" useGeneratedKeys="true" keyProperty="templateId">
        insert into biz_product_card_template (
            template_code, template_name, preview_url, metric_slot_count, has_main_amount,
            default_cta_text, sort, status, create_by, create_time, remark
        ) values (
            #{templateCode}, #{templateName}, #{previewUrl}, #{metricSlotCount}, #{hasMainAmount},
            #{defaultCtaText}, #{sort}, #{status}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateTemplate" parameterType="BizProductCardTemplate">
        update biz_product_card_template
        <set>
            <if test="templateName != null and templateName != ''">template_name = #{templateName},</if>
            <if test="previewUrl != null">preview_url = #{previewUrl},</if>
            <if test="metricSlotCount != null">metric_slot_count = #{metricSlotCount},</if>
            <if test="hasMainAmount != null">has_main_amount = #{hasMainAmount},</if>
            <if test="defaultCtaText != null">default_cta_text = #{defaultCtaText},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where template_id = #{templateId}
    </update>

    <delete id="deleteTemplateByIds" parameterType="Long">
        delete from biz_product_card_template where template_id in
        <foreach collection="array" item="templateId" open="(" separator="," close=")">
            #{templateId}
        </foreach>
    </delete>
</mapper>
