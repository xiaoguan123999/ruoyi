<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizGroupChatMapper">

    <resultMap type="BizGroupChat" id="BizGroupChatResult">
        <id     property="groupId"     column="group_id"/>
        <result property="title"       column="title"/>
        <result property="hint"        column="hint"/>
        <result property="qrUrl"       column="qr_url"/>
        <result property="remark"      column="remark"/>
        <result property="sort"        column="sort"/>
        <result property="status"      column="status"/>
        <result property="createBy"    column="create_by"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateBy"    column="update_by"/>
        <result property="updateTime"  column="update_time"/>
    </resultMap>

    <sql id="selectGroupChatVo">
        select group_id, title, hint, qr_url, remark, sort, status,
               create_by, create_time, update_by, update_time
        from biz_group_chat
    </sql>

    <select id="selectGroupChatById" parameterType="Long" resultMap="BizGroupChatResult">
        <include refid="selectGroupChatVo"/>
        where group_id = #{groupId}
    </select>

    <select id="selectGroupChatList" parameterType="BizGroupChat" resultMap="BizGroupChatResult">
        <include refid="selectGroupChatVo"/>
        <where>
            <if test="title != null and title != ''">and title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort asc, group_id asc
    </select>

    <insert id="insertGroupChat" parameterType="BizGroupChat" useGeneratedKeys="true" keyProperty="groupId">
        insert into biz_group_chat (
            title, hint, qr_url, remark, sort, status, create_by, create_time
        ) values (
            #{title}, #{hint}, #{qrUrl}, #{remark}, #{sort}, #{status}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateGroupChat" parameterType="BizGroupChat">
        update biz_group_chat
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="hint != null">hint = #{hint},</if>
            <if test="qrUrl != null">qr_url = #{qrUrl},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where group_id = #{groupId}
    </update>

    <delete id="deleteGroupChatByIds" parameterType="Long">
        delete from biz_group_chat where group_id in
        <foreach collection="array" item="groupId" open="(" separator="," close=")">
            #{groupId}
        </foreach>
    </delete>
</mapper>
