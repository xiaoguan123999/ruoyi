<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizRechargeMethodMapper">

    <resultMap type="BizRechargeMethod" id="BizRechargeMethodResult">
        <id     property="methodId"   column="method_id"/>
        <result property="methodCode" column="method_code"/>
        <result property="label"      column="label"/>
        <result property="iconUrl"    column="icon_url"/>
        <result property="isCs"       column="is_cs"/>
        <result property="status"     column="status"/>
        <result property="sortOrder"  column="sort_order"/>
        <result property="remark"     column="remark"/>
        <result property="createBy"   column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy"   column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectVo">
        select method_id, method_code, label, icon_url, is_cs, status, sort_order, remark,
               create_by, create_time, update_by, update_time
        from biz_recharge_method
    </sql>

    <select id="selectRechargeMethodById" parameterType="Long" resultMap="BizRechargeMethodResult">
        <include refid="selectVo"/>
        where method_id = #{methodId}
    </select>

    <select id="selectByMethodCode" parameterType="String" resultMap="BizRechargeMethodResult">
        <include refid="selectVo"/>
        where method_code = #{methodCode}
        limit 1
    </select>

    <select id="selectRechargeMethodList" parameterType="BizRechargeMethod" resultMap="BizRechargeMethodResult">
        <include refid="selectVo"/>
        <where>
            <if test="methodCode != null and methodCode != ''">and method_code = #{methodCode}</if>
            <if test="label != null and label != ''">and label like concat('%', #{label}, '%')</if>
            <if test="isCs != null and isCs != ''">and is_cs = #{isCs}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort_order asc, method_id asc
    </select>

    <insert id="insertRechargeMethod" parameterType="BizRechargeMethod" useGeneratedKeys="true" keyProperty="methodId">
        insert into biz_recharge_method (
            method_code, label, icon_url, is_cs, status, sort_order, remark, create_by, create_time
        ) values (
            #{methodCode}, #{label}, #{iconUrl}, #{isCs}, #{status}, #{sortOrder}, #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateRechargeMethod" parameterType="BizRechargeMethod">
        update biz_recharge_method
        <set>
            <if test="methodCode != null and methodCode != ''">method_code = #{methodCode},</if>
            <if test="label != null and label != ''">label = #{label},</if>
            <if test="iconUrl != null">icon_url = #{iconUrl},</if>
            <if test="isCs != null">is_cs = #{isCs},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where method_id = #{methodId}
    </update>

    <delete id="deleteRechargeMethodByIds" parameterType="Long">
        delete from biz_recharge_method where method_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
