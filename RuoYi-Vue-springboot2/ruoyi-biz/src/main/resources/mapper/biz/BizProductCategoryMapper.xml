<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizProductCategoryMapper">

    <resultMap type="BizProductCategory" id="BizProductCategoryResult">
        <id     property="categoryId"    column="category_id"/>
        <result property="categoryName"  column="category_name"/>
        <result property="coverUrl"      column="cover_url"/>
        <result property="status"        column="status"/>
        <result property="sort"          column="sort"/>
        <result property="createBy"      column="create_by"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateBy"      column="update_by"/>
        <result property="updateTime"    column="update_time"/>
        <result property="remark"        column="remark"/>
    </resultMap>

    <sql id="selectCategoryVo">
        select category_id, category_name, cover_url, status, sort,
               create_by, create_time, update_by, update_time, remark
        from biz_product_category
    </sql>

    <select id="selectCategoryById" parameterType="Long" resultMap="BizProductCategoryResult">
        <include refid="selectCategoryVo"/>
        where category_id = #{categoryId}
    </select>

    <select id="selectCategoryList" parameterType="BizProductCategory" resultMap="BizProductCategoryResult">
        <include refid="selectCategoryVo"/>
        <where>
            <if test="categoryName != null and categoryName != ''">and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort asc, category_id desc
    </select>

    <insert id="insertCategory" parameterType="BizProductCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into biz_product_category (
            category_name, cover_url, status, sort, create_by, create_time, remark
        ) values (
            #{categoryName}, #{coverUrl}, #{status}, #{sort}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateCategory" parameterType="BizProductCategory">
        update biz_product_category
        <set>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where category_id = #{categoryId}
    </update>

    <delete id="deleteCategoryByIds" parameterType="Long">
        delete from biz_product_category where category_id in
        <foreach collection="array" item="categoryId" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </delete>
</mapper>
