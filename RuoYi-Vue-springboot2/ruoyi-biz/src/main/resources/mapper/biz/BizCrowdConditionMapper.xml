<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizCrowdConditionMapper">

    <resultMap type="BizCrowdCondition" id="BizCrowdConditionResult">
        <id     property="conditionId"    column="condition_id"/>
        <result property="packageId"      column="package_id"/>
        <result property="labelType"      column="label_type"/>
        <result property="labelField"     column="label_field"/>
        <result property="operatorType"   column="operator_type"/>
        <result property="ruleValue"      column="rule_value"/>
        <result property="sort"           column="sort"/>
    </resultMap>

    <select id="selectConditionListByPackageId" parameterType="Long" resultMap="BizCrowdConditionResult">
        select condition_id, package_id, label_type, label_field, operator_type, rule_value, sort
        from biz_crowd_condition
        where package_id = #{packageId}
        order by sort asc, condition_id asc
    </select>

    <delete id="deleteConditionByPackageId" parameterType="Long">
        delete from biz_crowd_condition where package_id = #{packageId}
    </delete>

    <insert id="insertCondition" parameterType="BizCrowdCondition" useGeneratedKeys="true" keyProperty="conditionId">
        insert into biz_crowd_condition (
            package_id, label_type, label_field, operator_type, rule_value, sort
        ) values (
            #{packageId}, #{labelType}, #{labelField}, #{operatorType}, #{ruleValue}, #{sort}
        )
    </insert>
</mapper>
