<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizAboutMapper">

    <resultMap type="BizAbout" id="BizAboutResult">
        <id     property="aboutId"      column="about_id"/>
        <result property="title"        column="title"/>
        <result property="subtitle"     column="subtitle"/>
        <result property="content"      column="content"/>
        <result property="imageUrl"     column="image_url"/>
        <result property="sort"         column="sort"/>
        <result property="status"       column="status"/>
        <result property="createBy"     column="create_by"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateBy"     column="update_by"/>
        <result property="updateTime"   column="update_time"/>
        <result property="remark"       column="remark"/>
    </resultMap>

    <sql id="selectAboutVo">
        select about_id, title, subtitle, content, image_url, sort, status,
               create_by, create_time, update_by, update_time, remark
        from biz_about
    </sql>

    <select id="selectAboutById" parameterType="Long" resultMap="BizAboutResult">
        <include refid="selectAboutVo"/>
        where about_id = #{aboutId}
    </select>

    <select id="selectAboutList" parameterType="BizAbout" resultMap="BizAboutResult">
        <include refid="selectAboutVo"/>
        <where>
            <if test="title != null and title != ''">and title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort asc, about_id asc
    </select>

    <insert id="insertAbout" parameterType="BizAbout" useGeneratedKeys="true" keyProperty="aboutId">
        insert into biz_about (
            title, subtitle, content, image_url, sort, status, create_by, create_time, remark
        ) values (
            #{title}, #{subtitle}, #{content}, #{imageUrl}, #{sort}, #{status}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateAbout" parameterType="BizAbout">
        update biz_about
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="subtitle != null">subtitle = #{subtitle},</if>
            <if test="content != null">content = #{content},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where about_id = #{aboutId}
    </update>

    <delete id="deleteAboutByIds" parameterType="Long">
        delete from biz_about where about_id in
        <foreach collection="array" item="aboutId" open="(" separator="," close=")">
            #{aboutId}
        </foreach>
    </delete>
</mapper>
