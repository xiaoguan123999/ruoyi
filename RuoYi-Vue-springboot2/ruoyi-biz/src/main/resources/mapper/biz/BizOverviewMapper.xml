<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizOverviewMapper">

    <resultMap type="BizOverview" id="BizOverviewResult">
        <id     property="itemId"        column="item_id"/>
        <result property="itemKey"       column="item_key"/>
        <result property="title"         column="title"/>
        <result property="displayValue"  column="display_value"/>
        <result property="statusText"    column="status_text"/>
        <result property="statusColor"   column="status_color"/>
        <result property="imageUrl"      column="image_url"/>
        <result property="sort"          column="sort"/>
        <result property="status"        column="status"/>
        <result property="createBy"      column="create_by"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateBy"      column="update_by"/>
        <result property="updateTime"    column="update_time"/>
        <result property="remark"        column="remark"/>
    </resultMap>

    <sql id="selectOverviewVo">
        select item_id, item_key, title, display_value, status_text, status_color, image_url,
               sort, status, create_by, create_time, update_by, update_time, remark
        from biz_overview
    </sql>

    <select id="selectOverviewById" parameterType="Long" resultMap="BizOverviewResult">
        <include refid="selectOverviewVo"/>
        where item_id = #{itemId}
    </select>

    <select id="selectOverviewByItemKey" parameterType="String" resultMap="BizOverviewResult">
        <include refid="selectOverviewVo"/>
        where item_key = #{itemKey}
    </select>

    <select id="selectOverviewList" parameterType="BizOverview" resultMap="BizOverviewResult">
        <include refid="selectOverviewVo"/>
        <where>
            <if test="itemKey != null and itemKey != ''">and item_key = #{itemKey}</if>
            <if test="title != null and title != ''">and title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort asc, item_id asc
    </select>

    <insert id="insertOverview" parameterType="BizOverview" useGeneratedKeys="true" keyProperty="itemId">
        insert into biz_overview (
            item_key, title, display_value, status_text, status_color, image_url,
            sort, status, create_by, create_time, remark
        ) values (
            #{itemKey}, #{title}, #{displayValue}, #{statusText}, #{statusColor}, #{imageUrl},
            #{sort}, #{status}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateOverview" parameterType="BizOverview">
        update biz_overview
        <set>
            <if test="itemKey != null and itemKey != ''">item_key = #{itemKey},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="displayValue != null">display_value = #{displayValue},</if>
            <if test="statusText != null">status_text = #{statusText},</if>
            <if test="statusColor != null">status_color = #{statusColor},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where item_id = #{itemId}
    </update>

    <delete id="deleteOverviewByIds" parameterType="Long">
        delete from biz_overview where item_id in
        <foreach collection="array" item="itemId" open="(" separator="," close=")">
            #{itemId}
        </foreach>
    </delete>
</mapper>
