<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizCsChannelMapper">

    <resultMap type="BizCsChannel" id="CsChannelResult">
        <id     property="channelId"   column="channel_id"/>
        <result property="name"        column="name"/>
        <result property="channelType" column="channel_type"/>
        <result property="value"       column="value"/>
        <result property="qrUrl"       column="qr_url"/>
        <result property="linkUrl"     column="link_url"/>
        <result property="sort"        column="sort"/>
        <result property="status"      column="status"/>
        <result property="remark"      column="remark"/>
        <result property="createBy"    column="create_by"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateBy"    column="update_by"/>
        <result property="updateTime"  column="update_time"/>
    </resultMap>

    <sql id="selectVo">
        select channel_id, name, channel_type, value, qr_url, link_url, sort, status, remark,
               create_by, create_time, update_by, update_time
        from biz_cs_channel
    </sql>

    <select id="selectChannelById" parameterType="Long" resultMap="CsChannelResult">
        <include refid="selectVo"/>
        where channel_id = #{channelId}
    </select>

    <select id="selectChannelList" parameterType="BizCsChannel" resultMap="CsChannelResult">
        <include refid="selectVo"/>
        <where>
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="channelType != null and channelType != ''">and channel_type = #{channelType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort asc, channel_id asc
    </select>

    <insert id="insertChannel" parameterType="BizCsChannel" useGeneratedKeys="true" keyProperty="channelId">
        insert into biz_cs_channel (
            name, channel_type, value, qr_url, link_url, sort, status, create_by, create_time, remark
        ) values (
            #{name}, #{channelType}, #{value}, #{qrUrl}, #{linkUrl}, #{sort}, #{status}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateChannel" parameterType="BizCsChannel">
        update biz_cs_channel
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="channelType != null">channel_type = #{channelType},</if>
            <if test="value != null">value = #{value},</if>
            <if test="qrUrl != null">qr_url = #{qrUrl},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where channel_id = #{channelId}
    </update>

    <delete id="deleteChannelByIds" parameterType="Long">
        delete from biz_cs_channel where channel_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
